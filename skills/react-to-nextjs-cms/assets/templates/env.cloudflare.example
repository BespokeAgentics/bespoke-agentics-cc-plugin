# --- Local dev: no other vars needed (createLocalDatabase + LocalAuthProvider) ---
TINA_PUBLIC_IS_LOCAL=true

# --- Production (set in Cloudflare, and set TINA_PUBLIC_IS_LOCAL=false there) ---
# GitHub repo that holds the content (Tina commits edits here)
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Auth.js JWT secret — generate with: openssl rand -hex 16
NEXTAUTH_SECRET=changeme

# Upstash Redis datalayer (works on Workers over HTTP). Create a DB at upstash.com.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --media r2 (optional external media via next-tinacms-s3; R2 is S3-compatible):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=auto
