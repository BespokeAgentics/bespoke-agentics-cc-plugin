# --- Local dev: no other vars needed (createLocalDatabase + LocalAuthProvider) ---
TINA_PUBLIC_IS_LOCAL=true

# --- Production (set in Vercel; owner/repo/branch auto-fill from VERCEL_GIT_* if omitted) ---
GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_OWNER=      # optional on Vercel (falls back to VERCEL_GIT_REPO_OWNER)
# GITHUB_REPO=       # optional on Vercel (falls back to VERCEL_GIT_REPO_SLUG)
# GITHUB_BRANCH=     # optional on Vercel (falls back to VERCEL_GIT_COMMIT_REF)

# Auth.js JWT secret — generate with: openssl rand -hex 16
NEXTAUTH_SECRET=changeme

# --db upstash (default): provision "Upstash for Redis" via the Vercel Marketplace
# (Vercel KV was discontinued Dec 2024) — it injects these two:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --db mongodb (alternative): set an Atlas connection string instead of the KV vars:
# MONGODB_URI=

# --media s3|r2 (optional external media via next-tinacms-s3):
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=
