### Client component

```tsx
'use client';
import { useAgentSession } from '{{IMPORT_ROOT}}/../hooks/agent/useAgentSession';
import { useToolCalls } from '{{IMPORT_ROOT}}/../hooks/agent/useToolCalls';
import { useETA } from '{{IMPORT_ROOT}}/../hooks/agent/useETA';
import { useNotifications } from '{{IMPORT_ROOT}}/../hooks/agent/useNotifications';
import { sseClientTransport } from '{{IMPORT_ROOT}}/transport/sse-client';
import { useMemo } from 'react';

export function AgentRunPanel({ prompt }: { prompt: string }) {
  const transport = useMemo(
    () => sseClientTransport({ sessionId: crypto.randomUUID(), prompt }),
    [prompt],
  );
  const session = useAgentSession({ transport });
  const tools = useToolCalls(session.state);
  const eta = useETA(session.state, session.events);
  useNotifications({ state: session.state, sessionUrl: window.location.href });

  return (
    <div>
      <div>
        Step {tools.currentStep} of ~{tools.stepBudget} —
        {' '}{eta.elapsedLabel} elapsed, ETA {eta.etaLabel}
        {eta.isStalled && <span> (still running — last event {Math.round(eta.idleMs / 1000)}s ago)</span>}
      </div>

      <ul>
        {tools.all.map((t) => (
          <li key={t.toolUseId}>
            <code>{t.toolName}</code> — {t.status}
            {t.outputPreview && <pre>{t.outputPreview}</pre>}
          </li>
        ))}
      </ul>

      <pre>{session.state.textBuffer}</pre>

      <button onClick={() => session.abort('user')}>Abort</button>
    </div>
  );
}
```

Style with your own design system. The hooks are headless on purpose.

### Notification permission

Call once at app start (e.g. in a root layout client component):

```tsx
useEffect(() => {
  if ('Notification' in window && Notification.permission === 'default') {
    Notification.requestPermission();
  }
}, []);
```

## What to swap

- **SDK adapter** — drop in `@anthropic-ai/sdk` or Vercel `ai` by implementing `SdkAdapter` from `adapters/types.ts`.
- **Transport** — switch from SSE to WebSocket or Server Action by importing a different client.
- **LogSink** — `JsonlLogSink` (Node) vs `IndexedDbLogSink` (browser); both implement `LogSink`.

## What NOT to change

- The `AgentEvent` union shape. Add new variants; never mutate existing payloads.
- The reducer signature `(state, event) → state`. It must stay pure for replay.
- The single-source-of-truth principle. Do not branch UI logic off the raw SDK event shape.

## Replay

```ts
import { replay } from '{{IMPORT_ROOT}}/reducer';
import { JsonlLogSink } from '{{IMPORT_ROOT}}/log-sink/jsonl';

const sink = new JsonlLogSink();
const events: AgentEvent[] = [];
for await (const ev of sink.read(sessionId)) events.push(ev);
const state = replay(events); // identical to live state at session end
```
