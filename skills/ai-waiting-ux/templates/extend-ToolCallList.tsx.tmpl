/**
 * ToolCallList — extend-mode component. Renders the live tool-call list
 * next to the existing assistant bubble. The styling assumes Tailwind +
 * shadcn/ui; swap classes/components when the detected primitive differs.
 */
'use client';

import type { SessionState } from '{{IMPORT_ROOT}}/reducer';
import { useToolCalls } from '{{HOOKS_ROOT}}/useToolCalls';

export type ToolCallListProps = {
  state: SessionState;
  /** Pass the existing renderer's class to inherit container styling. */
  className?: string;
};

export function ToolCallList({ state, className }: ToolCallListProps) {
  const tools = useToolCalls(state);
  if (tools.all.length === 0) return null;

  return (
    <div className={className ?? 'mt-2 flex flex-col gap-1 text-sm'}>
      <div className="text-xs text-muted-foreground">
        Step {tools.currentStep} of ~{tools.stepBudget}
      </div>
      <ul className="flex flex-col gap-1">
        {tools.all.map((t) => (
          <li
            key={t.toolUseId}
            className="flex items-start gap-2 rounded-md border border-border/60 bg-muted/40 px-2 py-1"
          >
            <span
              aria-hidden
              className={
                t.status === 'running'
                  ? 'mt-1 size-2 animate-pulse rounded-full bg-amber-500'
                  : t.status === 'error'
                    ? 'mt-1 size-2 rounded-full bg-red-500'
                    : 'mt-1 size-2 rounded-full bg-emerald-500'
              }
            />
            <div className="flex min-w-0 flex-1 flex-col">
              <code className="truncate text-xs">{t.toolName}</code>
              {t.outputPreview && (
                <pre className="mt-1 max-h-24 overflow-hidden whitespace-pre-wrap break-words text-xs text-muted-foreground">
                  {t.outputPreview}
                </pre>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  );
}
