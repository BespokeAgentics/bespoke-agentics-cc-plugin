{
  "name": "project-db-{{SLUG}}",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server over the {{PROJECT_NAME}} project database on Cloudflare D1. Generated by project-db.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "secret:tokens": "wrangler secret put MCP_BEARER_TOKENS",
    "import:local": "wrangler d1 execute {{DATABASE_NAME}} --local --file=../d1/import.sql --yes",
    "import:remote": "wrangler d1 execute {{DATABASE_NAME}} --remote --file=../d1/import.sql --yes"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.0.0"
  }
}
