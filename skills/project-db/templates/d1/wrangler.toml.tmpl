# project-db MCP Worker — read-only SQL over the project's D1 database.
# Generated by the project-db skill (/db:publish). Safe to edit; regenerated only when missing.
name = "project-db-{{SLUG}}"
main = "src/index.ts"
compatibility_date = "2025-01-01"

[vars]
PROJECT_NAME = "{{PROJECT_NAME}}"
ROW_LIMIT = "200"
MAX_CELL_CHARS = "400"

[[d1_databases]]
binding = "DB"
database_name = "{{DATABASE_NAME}}"
database_id = "{{DATABASE_ID}}"

# Secrets (set with `wrangler secret put <NAME>` from this directory):
#   MCP_BEARER_TOKENS   comma-separated bearer tokens; the Worker refuses every request until this is set
