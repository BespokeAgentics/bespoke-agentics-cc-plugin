/**
 * project-db MCP Worker — read-only SQL over a D1 database, speaking MCP JSON-RPC over HTTPS.
 *
 * Generated by the project-db skill. The guardrails mirror the local engine (db.py): one statement per
 * call, SELECT/WITH/EXPLAIN only, forbidden-keyword scan, row cap, cell truncation, CSV by default,
 * every call audited into `_query_log`. D1 has no read-only role, so THIS WORKER is the read-only role:
 * the bearer token is the boundary and the validator is the policy.
 *
 * Endpoints
 *   GET  /health          → { ok, project, pages, last_sync }
 *   POST /mcp             → MCP JSON-RPC (initialize, ping, tools/list, tools/call)  [Bearer auth]
 */

export interface Env {
  DB: D1Database;
  MCP_BEARER_TOKENS?: string;
  PROJECT_NAME: string;
  ROW_LIMIT: string;
  MAX_CELL_CHARS: string;
}

type Json = Record<string, unknown>;

const FORBIDDEN =
  /\b(insert|update|delete|drop|alter|create|replace|attach|detach|pragma|vacuum|reindex|begin|commit|rollback|savepoint|release)\b/i;

function stripStrings(sql: string): string {
  return sql.replace(/'(?:[^']|'')*'|"(?:[^"]|"")*"|--[^\n]*|\/\*[\s\S]*?\*\//g, " ");
}

/** Belt (this) and braces (D1 rejects unknown statement shapes). Throws on anything but a read. */
function validate(sql: string): string {
  const s = sql.trim().replace(/;+\s*$/, "");
  const bare = stripStrings(s);
  if (bare.includes(";")) throw new Error("exactly one statement per call");
  if (!/^\s*(select|with|explain)\b/i.test(bare)) {
    throw new Error("only SELECT / WITH … SELECT / EXPLAIN QUERY PLAN are allowed — the database is read-only");
  }
  const m = bare.match(FORBIDDEN);
  if (m) throw new Error(`'${m[1]}' is not allowed in a read-only query`);
  return s;
}

function truncate(v: unknown, max: number): string {
  if (v === null || v === undefined) return "";
  const s = typeof v === "object" ? JSON.stringify(v) : String(v);
  return max && s.length > max ? s.slice(0, max) + `…[+${s.length - max} chars]` : s;
}

function csvCell(s: string): string {
  return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
}

function format(rows: Json[], fmt: string, maxCell: number): string {
  if (!rows.length) return "";
  const cols = Object.keys(rows[0]);
  if (fmt === "json") return JSON.stringify(rows.map((r) => Object.fromEntries(cols.map((c) => [c, truncate(r[c], maxCell)]))), null, 1);
  if (fmt === "md") {
    const head = `| ${cols.join(" | ")} |\n|${cols.map(() => "---").join("|")}|`;
    return head + "\n" + rows.map((r) => `| ${cols.map((c) => truncate(r[c], maxCell).replace(/\|/g, "\\|").replace(/\n/g, " ")).join(" | ")} |`).join("\n");
  }
  return [cols.map(csvCell).join(","), ...rows.map((r) => cols.map((c) => csvCell(truncate(r[c], maxCell))).join(","))].join("\n");
}

async function audit(env: Env, rec: { actor: string; tool: string; sql: string; rows?: number; ms?: number; truncated?: boolean; error?: string }) {
  try {
    await env.DB.prepare(
      "INSERT INTO _query_log (ts, actor, tool, sql, rows, ms, truncated, error) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)",
    )
      .bind(new Date().toISOString(), rec.actor, rec.tool, rec.sql, rec.rows ?? null, rec.ms ?? null, rec.truncated ? 1 : 0, rec.error ?? null)
      .run();
  } catch {
    /* the audit table is created by /db:publish; a missing table must not break reads */
  }
}

async function runQuery(env: Env, sqlText: string, limit: number, fmt: string, maxCell: number, actor: string): Promise<string> {
  const rec = { actor, tool: "db_query", sql: sqlText };
  let sql: string;
  try {
    sql = validate(sqlText);
  } catch (e) {
    await audit(env, { ...rec, error: String((e as Error).message) });
    return `error: ${(e as Error).message}`;
  }
  const wrapped = /^\s*explain/i.test(sql) ? sql : `SELECT * FROM (${sql}) LIMIT ${limit + 1}`;
  const t0 = Date.now();
  try {
    const res = await env.DB.prepare(wrapped).all<Json>();
    const rows = res.results ?? [];
    const truncated = rows.length > limit;
    const shown = truncated ? rows.slice(0, limit) : rows;
    const ms = Date.now() - t0;
    await audit(env, { ...rec, rows: shown.length, ms, truncated });
    let note = `\n# ${shown.length} row(s) · ${ms} ms`;
    if (truncated) note += ` · TRUNCATED at ${limit} rows — add WHERE / LIMIT`;
    return format(shown, fmt, maxCell) + note;
  } catch (e) {
    const msg = (e as Error).message;
    await audit(env, { ...rec, ms: Date.now() - t0, error: msg });
    return `error: ${msg}`;
  }
}

async function schema(env: Env, object: string): Promise<string> {
  if (!object) {
    const row = await env.DB.prepare("SELECT value FROM sync_state WHERE key = 'schema_md'").first<{ value: string }>();
    return row?.value ?? "error: schema summary not published yet — run /db:publish";
  }
  const exists = await env.DB.prepare("SELECT type FROM sqlite_master WHERE name = ?1").bind(object).first<{ type: string }>();
  if (!exists) return `error: no table or view named ${object}`;
  const docs = await env.DB.prepare("SELECT column, doc FROM column_docs WHERE object = ?1").bind(object).all<{ column: string; doc: string }>();
  const docMap = Object.fromEntries((docs.results ?? []).map((d) => [d.column, d.doc]));
  const info = await env.DB.prepare(`PRAGMA table_info("${object.replace(/"/g, "")}")`).all<{ name: string; type: string }>();
  const lines = [`# ${exists.type} ${object}` + (docMap._ ? ` — ${docMap._}` : "")];
  for (const c of info.results ?? []) lines.push(`- ${c.name} ${c.type ?? ""}`.trimEnd() + (docMap[c.name] ? ` — ${docMap[c.name]}` : ""));
  return lines.join("\n");
}

async function search(env: Env, terms: string, type: string, limit: number): Promise<string> {
  try {
    const sql =
      "SELECT p.slug, p.type, p.scope AS client, snippet(pages_fts, 1, '[', ']', '…', 14) AS hit FROM pages_fts JOIN pages p ON p.id = pages_fts.rowid WHERE pages_fts MATCH ?1" +
      (type ? " AND p.type = ?2" : "") +
      " ORDER BY rank LIMIT " +
      String(limit);
    const stmt = type ? env.DB.prepare(sql).bind(terms, type) : env.DB.prepare(sql).bind(terms);
    const res = await stmt.all<Json>();
    return format(res.results ?? [], "csv", 300) + `\n# ${(res.results ?? []).length} hit(s)`;
  } catch (e) {
    return `error: ${(e as Error).message} — quote phrases, e.g. "co-op billing"`;
  }
}

const TOOLS = [
  {
    name: "db_query",
    description:
      "Run ONE read-only SQL statement (SELECT / WITH … SELECT / EXPLAIN QUERY PLAN) against the project database. Returns CSV (default), json or md. Read db_schema first; prefer the typed views. Rows are capped and long cells truncated — narrow with WHERE / LIMIT. Every call is audited.",
    inputSchema: {
      type: "object",
      properties: {
        sql: { type: "string", description: "one SELECT statement" },
        limit: { type: "integer", description: "row cap (default from config)" },
        format: { type: "string", enum: ["csv", "json", "md"] },
        max_cell: { type: "integer", description: "truncate cells longer than N chars (0 = never)" },
      },
      required: ["sql"],
    },
  },
  {
    name: "db_schema",
    description: "Schema summary (tables, typed views, curated views, column docs, query patterns). Pass a table/view name for column detail. Read before writing SQL.",
    inputSchema: { type: "object", properties: { object: { type: "string" } } },
  },
  {
    name: "db_search",
    description: "Full-text search (FTS5) over page titles and bodies: slug, type, client, snippet. FTS syntax: `budget AND approval`, `\"co-op billing\"`, `warehouse*`.",
    inputSchema: {
      type: "object",
      properties: { terms: { type: "string" }, type: { type: "string" }, limit: { type: "integer" } },
      required: ["terms"],
    },
  },
];

function rpc(id: unknown, result: unknown): Response {
  return Response.json({ jsonrpc: "2.0", id, result });
}
function rpcError(id: unknown, code: number, message: string, status = 200): Response {
  return Response.json({ jsonrpc: "2.0", id, error: { code, message } }, { status });
}

function authorized(req: Request, env: Env): boolean {
  const tokens = (env.MCP_BEARER_TOKENS ?? "").split(",").map((t) => t.trim()).filter(Boolean);
  if (!tokens.length) return false; // fail closed until the secret is set
  const h = req.headers.get("authorization") ?? "";
  const m = h.match(/^Bearer\s+(.+)$/i);
  return !!m && tokens.includes(m[1].trim());
}

export default {
  async fetch(req: Request, env: Env): Promise<Response> {
    const url = new URL(req.url);
    if (req.method === "GET" && url.pathname === "/health") {
      try {
        const n = await env.DB.prepare("SELECT COUNT(*) AS n FROM pages").first<{ n: number }>();
        const last = await env.DB.prepare("SELECT value FROM sync_state WHERE key = 'last_sync'").first<{ value: string }>();
        return Response.json({ ok: true, project: env.PROJECT_NAME, pages: n?.n ?? 0, last_sync: last?.value ?? null, auth_configured: !!env.MCP_BEARER_TOKENS });
      } catch (e) {
        return Response.json({ ok: false, error: (e as Error).message }, { status: 500 });
      }
    }
    if (url.pathname !== "/mcp") return new Response("not found", { status: 404 });
    if (req.method !== "POST") return new Response("method not allowed", { status: 405 });
    if (!authorized(req, env)) {
      return new Response(env.MCP_BEARER_TOKENS ? "unauthorized" : "MCP_BEARER_TOKENS secret not set", { status: env.MCP_BEARER_TOKENS ? 401 : 503 });
    }
    let msg: { jsonrpc?: string; id?: unknown; method?: string; params?: Json };
    try {
      msg = (await req.json()) as typeof msg;
    } catch {
      return rpcError(null, -32700, "parse error", 400);
    }
    const id = msg.id ?? null;
    const p = (msg.params ?? {}) as Json;
    const limit = Number(env.ROW_LIMIT || 200);
    const maxCell = Number(env.MAX_CELL_CHARS || 400);
    const actor = req.headers.get("x-actor") ?? "mcp";
    switch (msg.method) {
      case "initialize":
        return rpc(id, {
          protocolVersion: (p.protocolVersion as string) ?? "2025-03-26",
          capabilities: { tools: {} },
          serverInfo: { name: `project-db (${env.PROJECT_NAME})`, version: "1.0.0" },
        });
      case "notifications/initialized":
        return new Response(null, { status: 202 });
      case "ping":
        return rpc(id, {});
      case "tools/list":
        return rpc(id, { tools: TOOLS });
      case "tools/call": {
        const name = p.name as string;
        const a = (p.arguments ?? {}) as Json;
        let text: string;
        if (name === "db_query") {
          text = await runQuery(env, String(a.sql ?? ""), Number(a.limit ?? limit) || limit, String(a.format ?? "csv"), a.max_cell === undefined ? maxCell : Number(a.max_cell), actor);
        } else if (name === "db_schema") {
          text = await schema(env, String(a.object ?? ""));
        } else if (name === "db_search") {
          text = await search(env, String(a.terms ?? ""), String(a.type ?? ""), Number(a.limit ?? 20) || 20);
        } else {
          return rpcError(id, -32602, `unknown tool ${name}`);
        }
        return rpc(id, { content: [{ type: "text", text }], isError: text.startsWith("error:") });
      }
      default:
        return rpcError(id, -32601, `method not found: ${msg.method}`);
    }
  },
};
