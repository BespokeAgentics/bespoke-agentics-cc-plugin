{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/start-{{SLUG}}.{{EXT}}",
            "timeout": {{TIMEOUT_SECONDS}}
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/start-{{SLUG}}.{{EXT}}",
            "timeout": {{TIMEOUT_SECONDS}}
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOOK_DIR}}/stop-{{SLUG}}.{{EXT}}",
            "timeout": {{TIMEOUT_SECONDS}}
          }
        ]
      }
    ]
  }
}
