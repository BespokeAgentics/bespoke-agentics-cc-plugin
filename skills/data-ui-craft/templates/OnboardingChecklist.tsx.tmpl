import { useEffect, useState } from "react";
import { Check, X } from "{{ICON_IMPORT}}";
import { cn } from "{{CN}}";

/**
 * Pillar 2 — Progressive disclosure over time.
 * Replaces a feature-dump onboarding modal with a sequenced checklist that introduces one
 * capability at a time and persists progress, so it doesn't re-overwhelm or re-show. Dismissible
 * and resumable. For "tips that appear when a feature becomes relevant", trigger steps from real
 * app events instead of showing them all at once.
 */
export type ChecklistStep = {
  id: string;
  title: string;
  description?: string;
  /** Optional CTA that performs / navigates to the step. */
  action?: React.ReactNode;
  /** Mark done from app state (e.g. the user really did create a project). */
  done?: boolean;
};

export function OnboardingChecklist({
  steps,
  storageKey = "onboarding-checklist",
  title = "Get started",
  onDismiss,
  className,
}: {
  steps: ChecklistStep[];
  /** localStorage key so progress + dismissal persist across sessions. */
  storageKey?: string;
  title?: string;
  onDismiss?: () => void;
  className?: string;
}) {
  const [dismissed, setDismissed] = useState(false);
  const [localDone, setLocalDone] = useState<Record<string, boolean>>({});

  // Resume from storage on mount.
  useEffect(() => {
    try {
      const raw = localStorage.getItem(storageKey);
      if (raw) {
        const saved = JSON.parse(raw) as { dismissed?: boolean; done?: Record<string, boolean> };
        setDismissed(Boolean(saved.dismissed));
        setLocalDone(saved.done ?? {});
      }
    } catch {
      /* ignore malformed storage */
    }
  }, [storageKey]);

  function persist(next: { dismissed?: boolean; done?: Record<string, boolean> }) {
    try {
      localStorage.setItem(
        storageKey,
        JSON.stringify({ dismissed, done: localDone, ...next }),
      );
    } catch {
      /* ignore quota / privacy mode */
    }
  }

  const isDone = (s: ChecklistStep) => s.done || localDone[s.id];
  const completed = steps.filter(isDone).length;

  if (dismissed || completed === steps.length) return null;

  return (
    <section
      className={cn("rounded-lg border border-gray-200 bg-white p-4 shadow-sm", className)}
      aria-label={title}
    >
      <div className="mb-3 flex items-center justify-between">
        <div>
          <h3 className="text-sm font-semibold text-gray-900">{title}</h3>
          <p className="text-xs text-gray-500">
            {completed} of {steps.length} done
          </p>
        </div>
        <button
          type="button"
          aria-label="Dismiss"
          onClick={() => {
            setDismissed(true);
            persist({ dismissed: true });
            onDismiss?.();
          }}
          className="rounded p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
        >
          <X className="h-4 w-4" aria-hidden />
        </button>
      </div>

      {/* progress bar */}
      <div className="mb-3 h-1.5 w-full overflow-hidden rounded-full bg-gray-100">
        <div
          className="h-full rounded-full bg-blue-500 transition-all"
          style={{ width: `${(completed / steps.length) * 100}%` }}
        />
      </div>

      <ul className="space-y-1">
        {steps.map((s) => {
          const done = isDone(s);
          return (
            <li key={s.id} className="flex items-start gap-3 rounded-md p-2 hover:bg-gray-50">
              <button
                type="button"
                aria-label={done ? `Mark "${s.title}" not done` : `Mark "${s.title}" done`}
                onClick={() => {
                  const next = { ...localDone, [s.id]: !done };
                  setLocalDone(next);
                  persist({ done: next });
                }}
                className={cn(
                  "mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border",
                  done ? "border-blue-500 bg-blue-500 text-white" : "border-gray-300 text-transparent",
                )}
              >
                <Check className="h-3 w-3" aria-hidden />
              </button>
              <div className="min-w-0 flex-1">
                <p className={cn("text-sm", done ? "text-gray-400 line-through" : "text-gray-900")}>
                  {s.title}
                </p>
                {s.description && !done && (
                  <p className="text-xs text-gray-500">{s.description}</p>
                )}
                {s.action && !done && <div className="mt-1">{s.action}</div>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  );
}
