import { MessageSquare } from "{{ICON_IMPORT}}";
import { cn } from "{{CN}}";
import { Tooltip } from "./Tooltip";

/**
 * Pillar 3 — Invisible UI.
 * Surfaces hidden context (comments / notes / attachments) tied to a row or cell with a small
 * indicator that doesn't clutter the grid. It's the entry point — onClick should open the full
 * thread (usually a drawer or popover; see the "orchestration" recipe). Renders nothing when
 * count is 0 so empty rows stay clean.
 */
export function CommentIndicator({
  count,
  onClick,
  label = "comments",
  className,
}: {
  count: number;
  onClick?: () => void;
  /** Noun for the tooltip/aria, e.g. "comments", "notes", "files". */
  label?: string;
  className?: string;
}) {
  if (!count) return null;
  const text = `${count} ${label}`;
  return (
    <Tooltip content={text}>
      <button
        type="button"
        onClick={onClick}
        aria-label={text}
        className={cn(
          "inline-flex items-center gap-0.5 rounded px-1 text-xs text-gray-500",
          "hover:text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500",
          className,
        )}
      >
        <MessageSquare className="h-3.5 w-3.5" aria-hidden />
        {count}
      </button>
    </Tooltip>
  );
}
