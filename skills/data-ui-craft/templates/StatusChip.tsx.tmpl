import { cn } from "{{CN}}";

/**
 * Pillar 1 — Data drives the form.
 * A status value rendered as a chip with MEANINGFUL color + a dot, so state is scannable.
 * Color never carries meaning alone (the label + dot survive color-blindness).
 *
 * Map your domain's status strings to a tone, then render <StatusChip status={row.status} />.
 */
type Tone = "neutral" | "info" | "success" | "warning" | "danger";

// Edit this map to your domain. Keys are your raw status values.
const STATUS_TONE: Record<string, Tone> = {
  active: "success",
  enabled: "success",
  pending: "warning",
  invited: "info",
  processing: "info",
  inactive: "neutral",
  disabled: "neutral",
  archived: "neutral",
  failed: "danger",
  error: "danger",
  suspended: "danger",
};

const TONE: Record<Tone, { chip: string; dot: string }> = {
  neutral: { chip: "bg-gray-100 text-gray-600 ring-gray-500/20", dot: "bg-gray-400" },
  info: { chip: "bg-blue-100 text-blue-800 ring-blue-600/20", dot: "bg-blue-500" },
  success: { chip: "bg-green-100 text-green-800 ring-green-600/20", dot: "bg-green-500" },
  warning: { chip: "bg-amber-100 text-amber-800 ring-amber-600/20", dot: "bg-amber-500" },
  danger: { chip: "bg-red-100 text-red-800 ring-red-600/20", dot: "bg-red-500" },
};

function titleCase(s: string) {
  return s.replace(/[_-]/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}

export function StatusChip({
  status,
  label,
  tone,
  className,
}: {
  status: string;
  /** Override the displayed label (defaults to a title-cased status). */
  label?: string;
  /** Override the tone if the status isn't in STATUS_TONE. */
  tone?: Tone;
  className?: string;
}) {
  const t = TONE[tone ?? STATUS_TONE[status] ?? "neutral"];
  return (
    <span
      className={cn(
        "inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset",
        t.chip,
        className,
      )}
    >
      <span className={cn("h-1.5 w-1.5 rounded-full", t.dot)} aria-hidden />
      {label ?? titleCase(status)}
    </span>
  );
}
