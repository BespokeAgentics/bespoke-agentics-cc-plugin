"""Google ADK agent for {PROJECT_NAME}."""
from __future__ import annotations

import os
import sys

from dotenv import load_dotenv

load_dotenv()

for var in ("GLEAN_API_TOKEN", "GLEAN_SERVER_URL", "GOOGLE_API_KEY"):
    if not os.getenv(var):
        sys.exit(f"Missing required env var: {var}")

from google.adk.agents import Agent  # noqa: E402
from glean.agent_toolkit.tools import {ENABLED_TOOLS_IMPORTS}  # noqa: E402

INSTRUCTION = (
    "You are a helpful assistant for {PROJECT_NAME}. "
    "Use the Glean tools to answer questions about company knowledge, people, and documents."
)

# `root_agent` is the conventional name ADK runners look for.
root_agent = Agent(
    name="{PROJECT_MODULE}",
    model="gemini-2.0-flash",
    description="Glean-powered assistant for {PROJECT_NAME}.",
    instruction=INSTRUCTION,
    tools=[{ENABLED_TOOLS_AS_ADK}],
)


if __name__ == "__main__":
    # Run via the ADK CLI (recommended): `adk run` or `adk web` from the project root.
    print("Defined root_agent. Run with `adk run` or `adk web` from the project root.")
