# Glean credentials (required)
# Get GLEAN_API_TOKEN from your Glean admin (Settings → API Tokens).
GLEAN_API_TOKEN=
GLEAN_SERVER_URL=https://your-company-be.glean.com

# Legacy: GLEAN_INSTANCE is the company slug only (e.g. "your-company"). Prefer GLEAN_SERVER_URL above.
# GLEAN_INSTANCE=

# Model provider credentials (set whichever your framework uses)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Retry tuning (optional — defaults shown)
# GLEAN_RETRY_INITIAL=1.0
# GLEAN_RETRY_MAX=50.0
# GLEAN_RETRY_MULTIPLIER=1.1
# GLEAN_RETRY_MAX_ELAPSED=60.0
