{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bespokeagentics.dev/graph-harness/graph.schema.json",
  "title": "Harness graph definition",
  "type": "object",
  "required": ["version", "name", "level", "entry", "budget", "nodes"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1, "maximum": 3 },
    "entry": { "type": "string", "minLength": 1 },
    "budget": {
      "type": "object",
      "required": ["max_steps", "max_retries_total"],
      "additionalProperties": false,
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1 },
        "max_retries_total": { "type": "integer", "minimum": 0 },
        "max_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "sensors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/sensor" } },
    "nodes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "sensor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["command", "file_exists", "file_contains", "json_schema", "contract_complete", "custom"] },
        "cmd": { "type": "string" },
        "path": { "type": "string" },
        "pattern": { "type": "string" },
        "schema": { "type": "string" },
        "module": { "type": "string" },
        "applies_to": { "type": "array", "items": { "type": "string", "enum": ["code", "ui", "research", "data", "mixed", "contract"] } },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "todo": { "type": "string", "description": "Set when a mechanical check is not yet possible; the sensor then reports pass=false with this reason unless allow_todo is true." },
        "allow_todo": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["contract", "load_context", "plan", "act", "verify", "policy_gate", "repair", "human_review", "receipt"] },
        "guides": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "tier": { "type": "string", "enum": ["read", "sandbox", "write", "network", "approve"] },
        "sensors": { "type": "array", "items": { "type": "string" } },
        "parallel": { "type": "boolean" },
        "subgraph": { "type": "string" },
        "risk": { "type": "string", "enum": ["reversible", "shared", "irreversible"] },
        "retry": {
          "type": "object",
          "required": ["max", "on_exhausted"],
          "additionalProperties": false,
          "properties": { "max": { "type": "integer", "minimum": 1 }, "on_exhausted": { "type": "string" } }
        },
        "edges": { "type": "object", "additionalProperties": { "type": "string" } },
        "terminal": { "type": "boolean" },
        "description": { "type": "string" }
      }
    }
  }
}
