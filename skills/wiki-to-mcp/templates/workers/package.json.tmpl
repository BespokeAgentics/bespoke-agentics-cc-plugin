{
  "name": "wiki-mcp-{{SLUG}}",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers MCP server for the {{PROJECT_NAME}} wiki. Generated by wiki-to-mcp.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:cron": "wrangler deploy --config wrangler.cron.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "secret:bearer": "wrangler secret put MCP_BEARER_TOKENS",
    "secret:gh-token": "wrangler secret put WIKI_GIT_TOKEN"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240725.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
