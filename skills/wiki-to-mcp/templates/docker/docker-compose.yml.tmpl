services:
  wiki-mcp-{{SLUG}}:
    build:
      context: .
      dockerfile: Dockerfile
    image: wiki-mcp-{{SLUG}}:latest
    container_name: wiki-mcp-{{SLUG}}
    restart: unless-stopped
    ports:
      - "${PORT:-10000}:10000"
    env_file:
      - .env
    volumes:
      - wiki-data:/var/data
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:10000/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

volumes:
  wiki-data:
    name: wiki-mcp-{{SLUG}}-data
