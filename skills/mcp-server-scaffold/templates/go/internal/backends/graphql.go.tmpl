package backends

import (
	"bytes"
	"context"
	"encoding/json"
	"net/http"

	myerr "{{GO_MODULE}}/internal/errors"
)

type GraphQL struct {
	endpoint string
	bearer   string
	hc       *http.Client
}

func NewGraphQL(endpoint, bearer string) *GraphQL {
	return &GraphQL{endpoint: endpoint, bearer: bearer, hc: &http.Client{}}
}

func (g *GraphQL) GetCompany(ctx context.Context, id string) (Company, error) {
	var data struct{ Company *Company `json:"company"` }
	if err := g.execute(ctx,
		`query($id: ID!) { company(id: $id) { id name country segment employeeCount } }`,
		map[string]any{"id": id}, &data); err != nil {
		return Company{}, err
	}
	if data.Company == nil { return Company{}, myerr.NotFound("Company", id) }
	return *data.Company, nil
}

func (g *GraphQL) SearchCompanies(ctx context.Context, in SearchCompaniesInput) ([]Company, error) {
	var data struct{ Companies []Company `json:"companies"` }
	err := g.execute(ctx,
		`query($f: CompanyFilters!, $limit: Int!) {
			companies(filters: $f, limit: $limit) { id name country segment employeeCount }
		}`,
		map[string]any{"f": map[string]any{"country": in.Country, "segment": in.Segment, "query": in.Query}, "limit": in.Limit},
		&data,
	)
	return data.Companies, err
}

func (g *GraphQL) AISearchCompanies(ctx context.Context, q string) ([]Company, error) {
	var data struct{ AICompanies []Company `json:"aiCompanies"` }
	err := g.execute(ctx,
		`query($q: String!) { aiCompanies(q: $q) { id name country segment employeeCount } }`,
		map[string]any{"q": q}, &data,
	)
	return data.AICompanies, err
}

func (g *GraphQL) CreateTicket(ctx context.Context, in CreateTicketInput) (Ticket, error) {
	var data struct{ CreateTicket Ticket `json:"createTicket"` }
	err := g.execute(ctx,
		`mutation($i: CreateTicketInput!) {
			createTicket(input: $i) { id subject status createdAt }
		}`,
		map[string]any{"i": in}, &data,
	)
	return data.CreateTicket, err
}

func (g *GraphQL) execute(ctx context.Context, query string, vars map[string]any, out any) error {
	body, err := json.Marshal(map[string]any{"query": query, "variables": vars})
	if err != nil { return myerr.Backend("encode: "+err.Error(), 0) }
	req, err := http.NewRequestWithContext(ctx, http.MethodPost, g.endpoint, bytes.NewReader(body))
	if err != nil { return myerr.Backend("build: "+err.Error(), 0) }
	req.Header.Set("content-type", "application/json")
	req.Header.Set("authorization", "Bearer "+g.bearer)
	res, err := g.hc.Do(req)
	if err != nil { return myerr.Backend("request: "+err.Error(), 0) }
	defer res.Body.Close()
	if res.StatusCode == 401 { return myerr.Unauthorized("Backend rejected token.") }
	if res.StatusCode >= 400 { return myerr.Backend("graphql status "+res.Status, res.StatusCode) }
	var envelope struct {
		Data   json.RawMessage `json:"data"`
		Errors []struct{ Message string `json:"message"` } `json:"errors"`
	}
	if err := json.NewDecoder(res.Body).Decode(&envelope); err != nil {
		return myerr.Backend("decode: "+err.Error(), 0)
	}
	if len(envelope.Errors) > 0 {
		return myerr.Backend(envelope.Errors[0].Message, 0)
	}
	return json.Unmarshal(envelope.Data, out)
}
