package tools

import (
	"context"

	myerr "{{GO_MODULE}}/internal/errors"
	"{{GO_MODULE}}/internal/pipeline"
)

// READ-ONLY tool. Must not import AssertMutationsEnabled.

type GetCompanyArgs struct {
	ID string `json:"id"`
}

func (a *GetCompanyArgs) Validate() error {
	if a.ID == "" { return myerr.Validation("id is required.", nil) }
	if len(a.ID) > 64 { return myerr.Validation("id must be 64 characters or fewer.", nil) }
	return nil
}

func GetCompanySpec() Spec {
	return Spec{
		Name:        "get_company",
		Description: "Fetch a single company by its canonical id. Returns NOT_FOUND for unknown ids.",
		Mutates:     false,
	}
}

func GetCompany(ctx context.Context, tctx *pipeline.ToolContext, a *GetCompanyArgs) (CompanyDTO, error) {
	c, err := tctx.Backend.GetCompany(ctx, a.ID)
	if err != nil { return CompanyDTO{}, err }
	return CompanyDTO{
		ID: c.ID, Name: c.Name, Country: c.Country,
		Segment: c.Segment, EmployeeCount: c.EmployeeCount,
	}, nil
}
