package logger

import (
	"log/slog"
	"os"
)

// New returns a slog.Logger writing structured JSON to stderr.
// Stdout is reserved for the MCP JSON-RPC protocol when stdio transport
// is in use — writing anything else to stdout corrupts the handshake.
func New() *slog.Logger {
	h := slog.NewJSONHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo})
	return slog.New(h)
}
