import { errors } from "../errors";
import type {
  BackendClient,
  Company,
  CreateTicketInput,
  SearchCompaniesInput,
  Ticket,
} from "./client";

// Minimal REST adapter. Treats the upstream as a JSON-over-HTTPS service.
// Real auth flows through the constructor — the user's bearer is forwarded
// unchanged so backend authorization runs against the user's identity.
export class RestBackend implements BackendClient {
  constructor(
    private readonly baseUrl: string,
    private readonly bearer: string,
  ) {}

  async getCompany(id: string): Promise<Company> {
    return this.json<Company>(`/companies/${encodeURIComponent(id)}`);
  }

  async searchCompanies(input: SearchCompaniesInput): Promise<Company[]> {
    const params = new URLSearchParams();
    if (input.country) params.set("country", input.country);
    if (input.segment) params.set("segment", input.segment);
    if (input.query) params.set("q", input.query);
    params.set("limit", String(input.limit));
    return this.json<Company[]>(`/companies?${params.toString()}`);
  }

  async aiSearchCompanies(q: string): Promise<Company[]> {
    return this.json<Company[]>(`/ai/companies/search`, {
      method: "POST",
      body: JSON.stringify({ q }),
    });
  }

  async createTicket(input: CreateTicketInput): Promise<Ticket> {
    return this.json<Ticket>(`/tickets`, {
      method: "POST",
      body: JSON.stringify(input),
    });
  }

  private async json<T>(path: string, init: RequestInit = {}): Promise<T> {
    const res = await fetch(`${this.baseUrl}${path}`, {
      ...init,
      headers: {
        "content-type": "application/json",
        "authorization": `Bearer ${this.bearer}`,
        ...(init.headers as Record<string, string> | undefined),
      },
    });
    if (res.status === 401) throw errors.unauthorized("Backend rejected token.");
    if (res.status === 404) throw errors.notFound("resource", path);
    if (!res.ok) throw errors.backend(`Backend ${res.status}: ${await res.text()}`, res.status);
    return (await res.json()) as T;
  }
}
