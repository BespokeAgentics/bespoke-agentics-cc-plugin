import { z } from "zod";
import type { Tool } from "../pipeline";

// READ-ONLY tool. No mutation gate import.
const Input = z.object({
  id: z.string().min(1).max(64),
});

const Output = z.object({
  id: z.string(),
  name: z.string(),
  country: z.string(),
  segment: z.string(),
  employeeCount: z.number(),
});

type In = z.infer<typeof Input>;
type Out = z.infer<typeof Output>;

export const getCompany: Tool<In, Out> = {
  name: "get_company",
  description: "Fetch a single company by its canonical id. Returns NotFound if no such company exists.",
  inputSchema: Input,
  outputSchema: Output,
  mutates: false,
  async execute(ctx, input) {
    const c = await ctx.backend.getCompany(input.id);
    return {
      id: c.id,
      name: c.name,
      country: c.country,
      segment: c.segment,
      employeeCount: c.employeeCount,
    };
  },
};
